# Terraform working directories and state.
# Note: .terraform.lock.hcl is deliberately NOT ignored - provider lock files
# belong in version control so everyone resolves the same provider builds.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files carry credentials; the .example versions are committed.
terraform.tfvars
*.auto.tfvars
backend.conf
packer_*.pkrvars.hcl
!*.example

# Generated cluster credentials
proxmox/talosconfig
proxmox/kubeconfig

# Keys and certs
*.cer
*.key
*.pem

# Packer plugin cache
packer/.packer.d/

# IDE
/.idea/
