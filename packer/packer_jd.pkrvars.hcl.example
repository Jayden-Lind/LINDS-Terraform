# Copy to packer_jd.pkrvars.hcl (gitignored) and fill in.
# The password is better passed as PKR_VAR_proxmox_password.

proxmox_node         = "jd-proxmox-02"
proxmox_url          = "https://10.0.50.246:8006/api2/json"
proxmox_storage_pool = "local-lvm"
disk_format          = "raw"

proxmox_username = "root@pam"
proxmox_password = "xxxxxxxx"

# Packer logs in to the guest with a key: the private key of the public key
# in http/user-data.
ssh_username         = "jayden"
ssh_private_key_file = "~/.ssh/id_rsa"
