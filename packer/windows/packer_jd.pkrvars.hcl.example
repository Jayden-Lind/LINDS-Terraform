# Copy to packer_jd.pkrvars.hcl (gitignored) and fill in.
# Anything sensitive is better passed as PKR_VAR_proxmox_password / PKR_VAR_admin_password.

proxmox_node         = "jd-proxmox-02"
proxmox_url          = "https://10.0.50.246:8006/api2/json"
proxmox_storage_pool = "ssd-mixed"
disk_format          = "raw"

proxmox_username = "root@pam"
proxmox_password = "xxxxxxxx"

# The same Evaluation ISO as at LINDS, under another name.
windows_iso_file = "local:iso/Windows_Server.iso"

# The JD servers are untagged on vmbr0 (VLAN 50, which has DHCP).
build_vlan = 0

# Letters and digits only, 16 or more. The same value goes in the Ansible vault
# as windows_bootstrap_password.
admin_password = "xxxxxxxxxxxxxxxx"
