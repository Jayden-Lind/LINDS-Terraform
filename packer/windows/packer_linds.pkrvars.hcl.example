# Copy to packer_linds.pkrvars.hcl (gitignored) and fill in.
# Anything sensitive is better passed as PKR_VAR_proxmox_password / PKR_VAR_admin_password.

proxmox_node         = "linds-proxmox-01"
proxmox_url          = "https://192.168.6.205:8006/api2/json"
proxmox_storage_pool = "local-lvm"
disk_format          = "raw"

proxmox_username = "root@pam"
proxmox_password = "xxxxxxxx"

windows_iso_file = "local:iso/26100.32230.260111-0550.lt_release_svc_refresh_SERVER_EVAL_x64FRE_en-us.iso"

# Letters and digits only, 16 or more. The same value goes in the Ansible vault
# as windows_bootstrap_password.
admin_password = "xxxxxxxxxxxxxxxx"
