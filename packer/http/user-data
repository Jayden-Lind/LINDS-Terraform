#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  refresh-installer:
    update: true
  # The minimal server. The key is source.id: an `id` at the top level is not
  # an autoinstall key, the installer ignored it, and the template was the
  # full server (source.id ubuntu-server) until 2026-11.
  source:
    id: ubuntu-server-minimal
    # No search for third-party drivers: a VM has only virtio devices.
    search_drivers: false
  # The kernel package for a VM: the same kernel as linux-generic, without
  # the firmware, the microcode and the headers that only hardware needs.
  # The installer adds it but still installs linux-generic and the firmware
  # (seen in a build, 2026-11). scripts/harden-and-trim.sh removes those.
  kernel:
    package: linux-image-virtual
  # kdump-tools keeps 512 MB of the memory of each clone for a second kernel
  # that saves a crash dump. This setting did not stop it in a build: the
  # minimal server has the package, and it puts crashkernel= on the kernel
  # command line. scripts/harden-and-trim.sh removes the package.
  kernel-crash-dumps:
    enabled: false
  storage:
    swap:
      size: 0
    layout:
      name: lvm
      sizing-policy: all
  ssh:
    install-server: true
    authorized-keys:
      [
        "ssh-rsa  root@jd-dev-01",
      ]
    # Keys only. Packer logs in with the key (ssh_private_key_file).
    allow-pw: false
  timezone: Australia/Melbourne
  updates: all
  packages:
    - qemu-guest-agent
    # growpart, which expand-root-lv.service below runs on every boot.
    - cloud-guest-utils
  late-commands:
     - curtin in-target -- sudo bash -c "echo uninitialized > /etc/machine-id"
     - curtin in-target -- sudo bash -c "echo uninitialized > /var/lib/dbus/machine-id"
  user-data:
    preserve_hostname: false
    ssh_authorized_keys:
      [
        "ssh-rsa  root@jd-dev-01",
      ]
    disable_root: false
    ssh_quiet_keygen: true
    users:
      - name: jayden
        groups: admin
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        # No password: SSH with the key, sudo without a password.
        lock_passwd: true
        ssh_authorized_keys:
          [
            "ssh-rsa  root@jd-dev-01",
          ]
    # Grows the root into whatever disk a clone was given. cloud-init cannot do
    # this itself: the root is an LVM volume, and its growpart module skips
    # device-mapper roots ("Resizing mapped device ... skipped"), so the unit
    # does all three steps - partition, PV, then LV and filesystem. A growpart
    # setting here would not help either; this user-data only reaches the
    # build's own boot, and clones get theirs from Terraform.
    write_files:
      - path: /etc/systemd/system/expand-root-lv.service
        permissions: "0644"
        content: |
          [Unit]
          Description=Grow root partition, PV, LV and filesystem to fill the disk
          # Ordering only, so cloud-init's own resize2fs is not running at the
          # same time. No Requires=: cloud-init.service became
          # cloud-init-network.service in 26.04, and requiring a unit that
          # does not exist stopped this one from ever starting.
          After=cloud-init-local.service cloud-init-network.service cloud-init.service
          ConditionPathExists=/dev/mapper/ubuntu--vg-ubuntu--lv

          [Service]
          Type=oneshot
          # grow partition 3 into the rest of the disk; growpart exits 1 when
          # there is nothing to grow, which is every boot but the first
          ExecStartPre=-/usr/bin/growpart /dev/sda 3
          # then make sure the PV knows its new size
          ExecStartPre=/sbin/pvresize /dev/sda3
          # then grow the LV **and** the filesystem in one step
          ExecStart=/sbin/lvextend -l +100%%FREE --resizefs /dev/mapper/ubuntu--vg-ubuntu--lv
          RemainAfterExit=yes

          [Install]
          WantedBy=multi-user.target
    # runcmd executes inside cloud-init's own scripts_user module, so anything
    # that resets cloud-init state here deletes it out from under the modules
    # still to run - which is what left an iid-datasource-none instance dir in
    # the image. The identity reset belongs in the Packer provisioner, after
    # `cloud-init status --wait`, and that is where it now lives.
    runcmd:
      - systemctl enable expand-root-lv.service
