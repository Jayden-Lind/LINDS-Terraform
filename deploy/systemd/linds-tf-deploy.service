[Unit]
Description=Apply LINDS-Terraform main to the Talos cluster (deploy/README.md)

[Service]
Type=oneshot
ExecStart=%h/.local/state/linds-tf-deploy/repo/deploy/linds-tf-deploy
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# A Talos upgrade of all seven nodes takes about an hour.
TimeoutStartSec=4h
# Terraform and its providers need well under this. The cap keeps an OOM kill
# inside this unit.
MemoryMax=4G
Nice=5
